# ── AEGIS root .dockerignore ──
# Docker reads THIS file when build context is the repo root.

# Git
.git
.gitignore

# Terraform
infra/terraform/.terraform
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfvars

# Python
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage
*.egg-info

# Node
node_modules
.next
.turbo

# Environments
.env
.envrc
.venv
venv

# IDE
.idea
.vscode
*.swp
*.swo

# Docs / Planner (not needed in images)
planner/
docs/
*.md
!requirements.txt

# Tests (not needed in production images)
tests/

# Docker
docker-compose.yml
.dockerignore
infra/docker/*.Dockerfile
